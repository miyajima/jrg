        {
          "id": "line-84",
          "kind": "paragraph",
          "text": "ContinuationToken indicates to Amazon S3 that the list is being continued on this bucket with a token. ContinuationToken is obfuscated and is not a real key. You can use this ContinuationToken for pagination of the list results.\n",
          "parent_id": "line-74",
          "start_line": 84,
          "end_line": 84
        },
        {
          "id": "line-102",
          "kind": "heading",
          "text": "###### Note\n",
