        {
          "end_line": 116,
          "id": "line-116",
          "kind": "paragraph",
          "parent_id": "line-76",
          "start_line": 116,
          "text": "These previously stable APIs are now stable in const contexts:\n"
        },
        {
          "end_line": 118,
          "id": "line-118",
          "kind": "list",
          "parent_id": "line-76",
          "start_line": 118,
          "text": "- NonNull<T>::replace\n"
        },
        {
