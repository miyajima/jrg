        },
        {
          "end_line": 134,
          "id": "line-134",
          "kind": "heading",
          "parent_id": "line-15",
          "start_line": 134,
          "text": "### Other changes\n"
        },
        {
          "end_line": 136,
          "id": "line-136",
          "kind": "paragraph",
          "parent_id": "line-134",
          "start_line": 136,
          "text": "The i686-pc-windows-gnu target has been demoted to Tier 2, as mentioned in an earlier post. This won't have any immediate effect for users, since both the compiler and standard library tools will still be distributed by rustup for this target. However, with less testing than it had at Tier 1, it has more chance of accumulating bugs in the future.\n"
        },
        {
          "end_line": 138,
          "id": "line-138",
          "kind": "paragraph",
          "parent_id": "line-134",
          "start_line": 138,
          "text": "Check out everything that changed in Rust, Cargo, and Clippy.\n"
        },
        {
          "end_line": 140,
          "id": "line-140",
          "kind": "heading",
          "start_line": 140,
          "text": "## Contributors to 1.88.0\n"
        },
        {
          "end_line": 142,
          "id": "line-142",
          "kind": "paragraph",
          "parent_id": "line-140",
          "start_line": 142,
          "text": "Many people came together to create Rust 1.88.0. We couldn't have done it without all of you. Thanks!\n"
        }
      ],
