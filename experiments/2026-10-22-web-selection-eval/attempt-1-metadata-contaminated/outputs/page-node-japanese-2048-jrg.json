        },
        {
          "id": "line-766",
          "kind": "heading",
          "text": "##### require.cache#\n",
          "parent_id": "line-744",
          "start_line": 766,
          "end_line": 766
        },
        {
          "id": "line-768",
          "kind": "paragraph",
          "text": "Added in: v0.3.0\n",
          "parent_id": "line-766",
          "start_line": 768,
          "end_line": 768
        },
        {
          "id": "line-770",
          "kind": "list",
          "text": "- <Object>\n",
          "parent_id": "line-766",
          "start_line": 770,
          "end_line": 770
        },
        {
          "id": "line-776",
          "kind": "code",
          "text": "```\nconst assert = require('node:assert');\nconst realFs = require('node:fs');\n\nconst fakeFs = {};\nrequire.cache.fs = { exports: fakeFs };\n\nassert.strictEqual(require('fs'), fakeFs);\nassert.strictEqual(require('node:fs'), realFs); copy\n```\n",
          "parent_id": "line-766",
          "start_line": 776,
          "end_line": 785
        },
        {
          "id": "line-787",
          "kind": "heading",
          "text": "##### require.extensions#\n",
          "parent_id": "line-744",
          "start_line": 787,
          "end_line": 787
        },
        {
          "id": "line-791",
          "kind": "paragraph",
          "text": "Stability: 0 - Deprecated\n",
          "parent_id": "line-787",
          "start_line": 791,
          "end_line": 791
        },
        {
          "id": "line-793",
          "kind": "list",
          "text": "- <Object>\n",
          "parent_id": "line-787",
          "start_line": 793,
          "end_line": 793
        },
        {
          "id": "line-795",
          "kind": "paragraph",
          "text": "Instruct require on how to handle certain file extensions.\n",
          "parent_id": "line-787",
          "start_line": 795,
          "end_line": 795
        },
        {
          "id": "line-799",
          "kind": "code",
          "text": "```\nrequire.extensions['.sjs'] = require.extensions['.js']; copy\n```\n",
          "parent_id": "line-787",
          "start_line": 799,
          "end_line": 801
        },
        {
          "id": "line-805",
          "kind": "paragraph",
          "text": "Avoid using require.extensions. Use could cause subtle bugs and resolving the extensions gets slower with each registered extension.\n",
          "parent_id": "line-787",
          "start_line": 805,
          "end_line": 805
        },
        {
          "id": "line-807",
          "kind": "heading",
          "text": "##### require.main#\n",
          "parent_id": "line-744",
          "start_line": 807,
          "end_line": 807
        },
        {
          "id": "line-811",
          "kind": "list",
          "text": "- <module> | <undefined>\n",
          "parent_id": "line-807",
          "start_line": 811,
          "end_line": 811
        },
        {
          "id": "line-815",
          "kind": "paragraph",
          "text": "In entry.js script:\n",
          "parent_id": "line-807",
          "start_line": 815,
          "end_line": 815
        },
        {
          "id": "line-817",
          "kind": "code",
          "text": "```\nconsole.log(require.main); copy\n```\n",
          "parent_id": "line-807",
          "start_line": 817,
          "end_line": 819
        },
        {
          "id": "line-821",
          "kind": "code",
          "text": "```\nnode entry.js copy\n```\n",
          "parent_id": "line-807",
          "start_line": 821,
          "end_line": 823
        },
        {
          "id": "line-840",
          "kind": "heading",
          "text": "##### require.resolve(request[, options])#\n",
          "parent_id": "line-744",
          "start_line": 840,
          "end_line": 840
        },
        {
          "id": "line-842",
          "kind": "paragraph",
          "text": "History\n",
          "parent_id": "line-840",
          "start_line": 842,
          "end_line": 842
        },
        {
          "id": "line-852",
          "kind": "list",
          "text": "- Returns: <string>\n",
          "parent_id": "line-840",
          "start_line": 852,
          "end_line": 852
        },
        {
          "id": "line-854",
          "kind": "paragraph",
          "text": "Use the internal require() machinery to look up the location of a module, but rather than loading the module, just return the resolved filename.\n",
          "parent_id": "line-840",
          "start_line": 854,
          "end_line": 854
        },
        {
          "id": "line-858",
          "kind": "heading",
          "text": "###### require.resolve.paths(request)#\n",
          "parent_id": "line-840",
          "start_line": 858,
          "end_line": 858
        },
        {
          "id": "line-860",
          "kind": "paragraph",
          "text": "Added in: v8.9.0\n",
