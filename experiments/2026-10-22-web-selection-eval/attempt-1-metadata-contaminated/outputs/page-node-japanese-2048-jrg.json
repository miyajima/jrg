        },
        {
          "id": "line-988",
          "kind": "heading",
          "text": "#### module.isPreloading#\n",
          "parent_id": "line-868",
          "start_line": 988,
          "end_line": 988
        },
        {
          "id": "line-990",
          "kind": "paragraph",
          "text": "Added in: v15.4.0, v14.17.0\n",
          "parent_id": "line-988",
          "start_line": 990,
          "end_line": 990
        },
        {
          "id": "line-1029",
          "kind": "heading",
          "text": "#### module.require(id)#\n",
          "parent_id": "line-868",
          "start_line": 1029,
          "end_line": 1029
        },
        {
          "id": "line-1037",
          "kind": "paragraph",
          "text": "The module.require() method provides a way to load a module as if require() was called from the original module.\n",
